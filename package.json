{
  "name": "octagon-hq",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "npm run generate:football-cfb-player-seasons",
    "dev": "vite",
    "build": "npm run typecheck && npm run build:artifacts",
    "build:artifacts": "vite build && vite build --config vite.worker.config.ts && npm run verify:artifact",
    "preview": "vite preview",
    "generate:football-cfb-player-seasons": "node scripts/generate-football-cfb-player-season-recognition.mjs",
    "generate:football-factual-universe": "node scripts/generate-football-factual-universe.mjs",
    "generate:football-ledger-audit": "node scripts/generate-football-ledger-audit.mjs",
    "pretypecheck": "npm run generate:football-cfb-player-seasons && npm run generate:football-factual-universe && npm run generate:football-ledger-audit",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run generate:football-cfb-player-seasons && npm run generate:football-factual-universe && npm run generate:football-ledger-audit",
    "test": "vitest run",
    "verify:artifact": "node scripts/verify-production-artifact.mjs",
    "export:verdict": "node scripts/export-octagon-verdict.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.7",
    "@tanstack/react-query": "5.101.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "7.18.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.0.4",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
