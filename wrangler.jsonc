{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "octagon",
  "main": "./dist/_worker.js",
  "compatibility_date": "2026-07-22",
  "browser": {
    "binding": "BROWSER"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/internal/ufc-source",
      "/fighters/*",
      "/rankings",
      "/rankings/",
      "/picks",
      "/picks/",
      "/play",
      "/play/*",
      "/share-preview/*"
    ]
  }
}
