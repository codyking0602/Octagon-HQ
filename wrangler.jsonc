{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "octagon",
  "main": "./dist/worker.js",
  "compatibility_date": "2026-07-22",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/supabase/*"
    ]
  }
}
